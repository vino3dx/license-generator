{
  "name": "aegis-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Aegis 授权管理中控（Electron + Vue 3 + TypeScript）",
  "author": "Aegis",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "vue-tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "test": "vitest run",
    "godot:vectors": "node scripts/godot-vectors.mjs",
    "godot:release": "node scripts/godot-vectors.mjs --release",
    "godot:strict": "node scripts/godot-strict.mjs",
    "godot:sync": "node scripts/sync-godot-addon.mjs",
    "strict:cases": "node scripts/build-strict-json-cases.mjs",
    "test:godot-integration": "vitest run tests/integration/godot-real-license.test.ts",
    "smoke": "node scripts/electron-smoke.mjs"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "^2.5.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "jsdom": "^30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
