{
  "version": 1,
  "note": "由 scripts/build-strict-json-cases.mjs 生成；Node 与 Godot 共用。不要手工编辑。",
  "json_cases": [
    {
      "id": "valid-empty-object",
      "input": "{}",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "valid-empty-array",
      "input": "[]",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "valid-simple",
      "input": "{\"a\":1}",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "valid-zero",
      "input": "{\"a\":0}",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "valid-max-safe-integer",
      "input": "{\"a\":9007199254740991}",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "valid-string",
      "input": "{\"a\":\"hello\"}",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "valid-cjk",
      "input": "{\"a\":\"中文测试\"}",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "valid-literals",
      "input": "{\"a\":true,\"b\":false,\"c\":null}",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "valid-array",
      "input": "{\"a\":[1,2,3]}",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "valid-nested",
      "input": "{\"a\":{\"b\":{\"c\":1}}}",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "valid-whitespace",
      "input": " \t\r\n{ \"a\" : 1 } \n",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "valid-escapes",
      "input": "{\"a\":\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"}",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "valid-unicode-escape",
      "input": "{\"a\":\"\\u0041\"}",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "valid-surrogate-pair",
      "input": "{\"a\":\"\\uD83D\\uDE00\"}",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "valid-empty-string",
      "input": "{\"a\":\"\"}",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "dup-key",
      "input": "{\"a\":1,\"a\":2}",
      "expect": "json_duplicate_key",
      "expect_ok": false
    },
    {
      "id": "dup-key-nested",
      "input": "{\"a\":{\"b\":1,\"b\":2}}",
      "expect": "json_duplicate_key",
      "expect_ok": false
    },
    {
      "id": "dup-key-object-then-scalar",
      "input": "{\"a\":1,\"a\":{\"b\":2}}",
      "expect": "json_duplicate_key",
      "expect_ok": false
    },
    {
      "id": "dup-key-in-array-element",
      "input": "{\"a\":[{\"b\":1,\"b\":2}]}",
      "expect": "json_duplicate_key",
      "expect_ok": false
    },
    {
      "id": "dup-key-different-order",
      "input": "{\"a\":1,\"b\":2,\"a\":3}",
      "expect": "json_duplicate_key",
      "expect_ok": false
    },
    {
      "id": "num-float",
      "input": "{\"a\":1.5}",
      "expect": "json_invalid_number",
      "expect_ok": false
    },
    {
      "id": "num-float-zero",
      "input": "{\"a\":1.0}",
      "expect": "json_invalid_number",
      "expect_ok": false
    },
    {
      "id": "num-exponent",
      "input": "{\"a\":1e3}",
      "expect": "json_invalid_number",
      "expect_ok": false
    },
    {
      "id": "num-exponent-upper",
      "input": "{\"a\":1E3}",
      "expect": "json_invalid_number",
      "expect_ok": false
    },
    {
      "id": "num-leading-zero",
      "input": "{\"a\":01}",
      "expect": "json_invalid_number",
      "expect_ok": false
    },
    {
      "id": "num-negative",
      "input": "{\"a\":-1}",
      "expect": "json_invalid_number",
      "expect_ok": false
    },
    {
      "id": "num-negative-zero",
      "input": "{\"a\":-0}",
      "expect": "json_invalid_number",
      "expect_ok": false
    },
    {
      "id": "num-over-safe",
      "input": "{\"a\":9007199254740992}",
      "expect": "json_invalid_number",
      "expect_ok": false
    },
    {
      "id": "num-huge",
      "input": "{\"a\":123456789012345678901234567890}",
      "expect": "json_invalid_number",
      "expect_ok": false
    },
    {
      "id": "trailing-junk",
      "input": "{\"a\":1} junk",
      "expect": "json_trailing_data",
      "expect_ok": false
    },
    {
      "id": "trailing-object",
      "input": "{\"a\":1}{\"b\":2}",
      "expect": "json_trailing_data",
      "expect_ok": false
    },
    {
      "id": "unclosed-object",
      "input": "{\"a\":1",
      "expect": "json_syntax",
      "expect_ok": false
    },
    {
      "id": "missing-value",
      "input": "{\"a\":}",
      "expect": "json_syntax",
      "expect_ok": false
    },
    {
      "id": "missing-colon",
      "input": "{\"a\" 1}",
      "expect": "json_syntax",
      "expect_ok": false
    },
    {
      "id": "missing-comma",
      "input": "{\"a\":1 \"b\":2}",
      "expect": "json_syntax",
      "expect_ok": false
    },
    {
      "id": "unquoted-key",
      "input": "{a:1}",
      "expect": "json_syntax",
      "expect_ok": false
    },
    {
      "id": "single-quotes",
      "input": "{'a':1}",
      "expect": "json_syntax",
      "expect_ok": false
    },
    {
      "id": "array-unclosed",
      "input": "[1,2",
      "expect": "json_syntax",
      "expect_ok": false
    },
    {
      "id": "array-trailing-comma",
      "input": "[1,]",
      "expect": "json_syntax",
      "expect_ok": false
    },
    {
      "id": "object-trailing-comma",
      "input": "{\"a\":1,}",
      "expect": "json_syntax",
      "expect_ok": false
    },
    {
      "id": "bare-word",
      "input": "truex",
      "expect": "json_trailing_data",
      "expect_ok": false
    },
    {
      "id": "empty-input",
      "input": "",
      "expect": "json_empty",
      "expect_ok": false
    },
    {
      "id": "only-whitespace",
      "input": "   ",
      "expect": "json_empty",
      "expect_ok": false
    },
    {
      "id": "escape-unknown",
      "input": "{\"a\":\"\\x41\"}",
      "expect": "json_invalid_escape",
      "expect_ok": false
    },
    {
      "id": "escape-truncated-u",
      "input": "{\"a\":\"\\u12\"}",
      "expect": "json_invalid_escape",
      "expect_ok": false
    },
    {
      "id": "escape-bad-hex",
      "input": "{\"a\":\"\\u12G4\"}",
      "expect": "json_invalid_escape",
      "expect_ok": false
    },
    {
      "id": "escape-lone-high-surrogate",
      "input": "{\"a\":\"\\uD800\"}",
      "expect": "json_invalid_escape",
      "expect_ok": false
    },
    {
      "id": "escape-lone-low-surrogate",
      "input": "{\"a\":\"\\uDC00\"}",
      "expect": "json_invalid_escape",
      "expect_ok": false
    },
    {
      "id": "escape-high-then-normal",
      "input": "{\"a\":\"\\uD800\\u0041\"}",
      "expect": "json_invalid_escape",
      "expect_ok": false
    },
    {
      "id": "escape-backslash-eof",
      "input": "{\"a\":\"\\",
      "expect": "json_invalid_escape",
      "expect_ok": false
    },
    {
      "id": "control-char-0x01",
      "input": "{\"a\":\"\u0001\"}",
      "expect": "json_control_char",
      "expect_ok": false
    },
    {
      "id": "control-char-newline",
      "input": "{\"a\":\"a\nb\"}",
      "expect": "json_control_char",
      "expect_ok": false
    },
    {
      "id": "control-char-tab",
      "input": "{\"a\":\"a\tb\"}",
      "expect": "json_control_char",
      "expect_ok": false
    },
    {
      "id": "depth-8-allowed",
      "input": "{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":1}}}}}}}}",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "depth-9-rejected",
      "input": "{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":1}}}}}}}}}",
      "expect": "json_too_deep",
      "expect_ok": false
    },
    {
      "id": "string-16384-allowed",
      "input": "{\"a\":\"\"}",
      "expect": "ok",
      "expect_ok": true
    },
    {
      "id": "string-16385-rejected",
      "input": "{\"a\":\"\"}",
      "expect": "json_string_too_long",
      "expect_ok": false
    }
  ],
